{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murador-equipamientos",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DECANTS",
      "id": "REEMPLAZAR_CON_ID_KV_MURADOR"
    }
  ]
}